# ---------------------------------------------------------------------------
# LLM transport (provider-neutral)
# ---------------------------------------------------------------------------
# Base URL of the agent/inference server that the Security Agent talks to.
LLM_BASE_URL=http://127.0.0.1:4096

# Model identifier understood by that server. The id must exist on the
# configured provider (check: curl -s $LLM_BASE_URL/provider).
# `LLM_MODEL` is accepted as a legacy alias for this variable.
LLM_MODEL_ID=opencode/deepseek-v4-flash-free

# Provider identifier understood by that server (may be ignored by some servers).
LLM_PROVIDER_ID=opencode

# Agent mode the server should run in (e.g. build, plan, general).
LLM_MODE=build

# Per-request timeout in seconds.
LLM_TIMEOUT=300

# Reuse one server-side session across findings.
# false = one fresh session per finding (recommended for evaluation).
LLM_REUSE_SESSION=false

# ---------------------------------------------------------------------------
# Phase 2 execution
# ---------------------------------------------------------------------------
# multi_agent = the proposed design: a Scanner proposes hypotheses and a
# Verifier judges each one against an evidence packet. single_agent merges the
# two roles, which is how the contribution of the split is ablated.
PHASE2_ARCHITECTURE=multi_agent

PHASE2_MAX_GROUPS=50
PHASE2_CONCURRENCY=4
PHASE2_CONTEXT_RADIUS=8

# false = drop Tree-sitter structural evidence from the packet (experiment C),
# true = full evidence packet (experiment D).
PHASE2_INCLUDE_STRUCTURAL=true

# Dataflow evidence. Turning this off makes the verifier's source-to-sink
# requirement unverifiable, so it is on by default and exists for ablation.
PHASE2_INCLUDE_TAINT=true

# A CONFIRMED verdict for a class the taint engine models is dropped unless a
# real source-to-sink path is present in the file. Also enforced when false;
# the flag only controls the engine-side check.
PHASE2_REQUIRE_CHAIN_EVIDENCE=true

# Drop a finding whose path the engine recognised as already mitigated. Off by
# default: the verifier may have a context-based reason the rule missed.
PHASE2_REJECT_MITIGATED=false

# A CONFIRMED verdict below this confidence is downgraded to UNCERTAIN.
PHASE2_MIN_CONFIDENCE=0.5

# ---------------------------------------------------------------------------
# Phase 3 matching
# ---------------------------------------------------------------------------
PHASE3_LINE_TOLERANCE=5

# ---------------------------------------------------------------------------
# Scenario references
# ---------------------------------------------------------------------------
SCENARIO_PHASE1_SOURCE=examples/cpp/vulnerable.cpp
SCENARIO_PHASE2_SOURCE=examples/cpp/vulnerable.cpp
SCENARIO_PHASE3_DATASET=datasets/juliet_test.json
SCENARIO_PHASE3_MODE=phase1
SCENARIO_FULL_SOURCE=examples/cpp/vulnerable.cpp
SCENARIO_FULL_DATASET=datasets/juliet_test.json
SCENARIO_FULL_MODE=phase2
