# ---------------------------------------------------------------------------
# LLM transport (provider-neutral)
# ---------------------------------------------------------------------------
# Base URL of the agent/inference server that the Security Agent talks to.
LLM_BASE_URL=http://127.0.0.1:4096

# Model identifier understood by that server. The id must exist on the
# configured provider (check: curl -s $LLM_BASE_URL/provider).
# `LLM_MODEL` is accepted as a legacy alias for this variable.
LLM_MODEL_ID=opencode/deepseek-v4-flash-free

# Provider identifier understood by that server (may be ignored by some servers).
LLM_PROVIDER_ID=opencode

# Agent mode the server should run in (e.g. build, plan, general).
LLM_MODE=build

# Per-request timeout in seconds.
LLM_TIMEOUT=300

# Sampling temperature. Verdicts have to be repeatable: at 1.0 the same
# evidence packet came back CONFIRMED on one run and REJECTED on the next.
LLM_TEMPERATURE=0.2

# Hidden reasoning budget per request: minimal | low | medium | high.
# A reasoning model spends most of its output tokens (and most of its
# latency) thinking before it answers, so this is the cheapest quality/cost
# trade in the whole config: the default spent ~150 reasoning tokens per
# request while "low" and "minimal" both spend ~0 on this endpoint, which
# cut a full 20-sample run from ~646k to ~36k output tokens. Prefer "low"
# over "minimal": the two cost the same here, but "minimal" doubled the
# LLM-only leg's false positives. Empty = do not send the field; a provider
# that rejects it is handled by dropping it once and retrying, so an unknown
# parameter cannot break a run.
LLM_REASONING_EFFORT=low

# Output ceiling per request, and the cap the budget escalation stops at.
# openai_compat starts at LLM_MAX_TOKENS and doubles on a reply cut off at
# finish_reason=length (each doubling is another API call on the critical
# path); a reply that still does not fit under LLM_MAX_TOKENS_CAP is a
# runaway and is reported as TruncatedResponse. Cap it: one runaway walked
# 8192 -> 16384 -> 32768 -> 65536 in 315s and was cut off anyway.
LLM_MAX_TOKENS=8192
LLM_MAX_TOKENS_CAP=32768

# Reuse one server-side session across findings.
# false = one fresh session per finding (recommended for evaluation).
LLM_REUSE_SESSION=false

# Retries, one budget per kind of failure (see agents/security_agent.py):
#   LLM_MAX_ATTEMPTS       a reply that came back unparsable (default 2; the
#                          retry restates the output contract instead of
#                          resending the identical prompt)
#   LLM_TRANSPORT_ATTEMPTS a dropped connection or a failed API call such as
#                          an upstream 503 (default 4; waits out a jittered
#                          backoff of ~2/4/8s, capped at 20s)
#   LLM_TIMEOUT_ATTEMPTS   a request that ran to LLM_TIMEOUT (default 2; each
#                          try already cost the full timeout)
LLM_MAX_ATTEMPTS=2
LLM_TRANSPORT_ATTEMPTS=4
LLM_TIMEOUT_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Phase 2 execution
# ---------------------------------------------------------------------------
# multi_agent = the proposed design: a Scanner proposes hypotheses and a
# Verifier judges each one against an evidence packet. single_agent merges the
# two roles, which is how the contribution of the split is ablated.
PHASE2_ARCHITECTURE=multi_agent

PHASE2_MAX_GROUPS=50
PHASE2_CONCURRENCY=4
PHASE2_CONTEXT_RADIUS=8

# false = drop Tree-sitter structural evidence from the packet (experiment C),
# true = full evidence packet (experiment D).
PHASE2_INCLUDE_STRUCTURAL=true

# Dataflow evidence. Turning this off makes the verifier's source-to-sink
# requirement unverifiable, so it is on by default and exists for ablation.
PHASE2_INCLUDE_TAINT=true

# A CONFIRMED verdict for a class the taint engine models is dropped unless a
# real source-to-sink path is present in the file. Also enforced when false;
# the flag only controls the engine-side check.
PHASE2_REQUIRE_CHAIN_EVIDENCE=true

# Drop a finding whose path the engine recognised as already mitigated. Off by
# default: the verifier may have a context-based reason the rule missed.
PHASE2_REJECT_MITIGATED=false

# A CONFIRMED verdict below this confidence is rejected rather than reported.
PHASE2_MIN_CONFIDENCE=0.5

# Extra questions when the verifier answers UNCERTAIN (or replies without a
# verdict at all). Only CONFIRMED counts as a detection, so a model that
# hedges over code it has read loses recall for being cautious; the repeat
# states the contract once more over the same packet, and a hedge that
# persists is resolved by the pipeline (verified path -> judged as a
# confirmation, no verified path -> rejection). 0 = one question per
# hypothesis, which is the cheapest setting.
PHASE2_HEDGE_RETRIES=1

# Claim handling. A hypothesis restates a claim it already raised when it
# names the same CWE a few lines down: PHASE2_MERGE_CLAIMS verifies such a
# restatement as one claim (one verifier pass per distinct site, stopping at
# the first CONFIRMED), and PHASE2_MERGE_FINDINGS folds confirmed findings
# whose CWE families overlap into a single report entry. Both default to
# true; turn them off to ablate. PHASE2_CLAIM_SITE_RADIUS is the line
# distance, from the primary entry, within which merged entries stay attached
# to a line -- past it the merged entry reports no line rather than a line
# that only one of the folded findings actually pointed at.
PHASE2_MERGE_CLAIMS=true
PHASE2_MERGE_FINDINGS=true
PHASE2_CLAIM_SITE_RADIUS=5

# ---------------------------------------------------------------------------
# Phase 3 matching
# ---------------------------------------------------------------------------
PHASE3_LINE_TOLERANCE=5

# ---------------------------------------------------------------------------
# Scenario references
# ---------------------------------------------------------------------------
SCENARIO_PHASE1_SOURCE=examples/cpp/vulnerable.cpp
SCENARIO_PHASE2_SOURCE=examples/cpp/vulnerable.cpp
SCENARIO_PHASE3_DATASET=datasets/vulnllm_r_c.json
SCENARIO_PHASE3_MODE=phase1
SCENARIO_FULL_SOURCE=examples/cpp/vulnerable.cpp
SCENARIO_FULL_DATASET=datasets/vulnllm_r_c.json
SCENARIO_FULL_MODE=phase2
